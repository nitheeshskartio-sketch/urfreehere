# ---------------------------------------------------------------------------
# Signaling server
# ---------------------------------------------------------------------------
PORT=3001
HOST=0.0.0.0
NODE_ENV=development   # production enables strict rate limits

# Set to true behind a reverse proxy (nginx, Caddy, a load balancer) so the
# real client IP is used for rate limiting and HTTPS detection.
TRUST_PROXY=false
# Redirect HTTP to HTTPS and send HSTS. Enable in production behind TLS.
FORCE_HTTPS=false

# Serve the built client (client/dist) from this server. Set to false if the
# frontend is hosted elsewhere (then also set CORS_ORIGINS and VITE_SIGNALING_URL).
SERVE_CLIENT=true
# Comma-separated origins allowed to open signaling sockets when the frontend
# is on a different origin. Leave empty for same-origin deployments.
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# UR Chat
# ---------------------------------------------------------------------------
# MongoDB for chat accounts: profile and basic details only (never messages or
# files). Put the real connection string in .env, which is git-ignored.
# Leave empty to run without accounts.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=urfreehere
# Accounts with no activity for this many days are deleted by a MongoDB TTL index.
ACCOUNT_INACTIVE_DAYS=7

# Group invitation metadata (token, code, preview, limits) is saved here so
# invite links survive restarts. "none" keeps it in memory only.
CHAT_DATA_FILE=data/chat-invites.json

# ---------------------------------------------------------------------------
# Rooms
# ---------------------------------------------------------------------------
ROOM_TTL_SECONDS=1800              # how long a code waits for a receiver
ROOM_PAIRED_TTL_SECONDS=7200       # room lifetime once a receiver joined
ROOM_RECONNECT_GRACE_SECONDS=45    # seat kept while a phone's socket reconnects
MAX_ROOMS=10000

# ---------------------------------------------------------------------------
# Rate limits (per client IP, per window). Unset = defaults below in
# production; much higher defaults when NODE_ENV is not "production".
# ---------------------------------------------------------------------------
RATE_WINDOW_SECONDS=600
RATE_ROOM_CREATES=20
RATE_JOIN_ATTEMPTS=30
RATE_CONNECTIONS=60
RATE_SIGNALS_PER_SECOND=50

# ---------------------------------------------------------------------------
# ICE (STUN / TURN) — see docs/STUN_TURN.md
# ---------------------------------------------------------------------------
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN is optional. Used only when a direct connection is impossible.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp

# Preferred: time-limited credentials (coturn `use-auth-secret` + `static-auth-secret`).
# TURN_SECRET=change-me-to-a-long-random-string
# TURN_CREDENTIAL_TTL_SECONDS=21600

# Alternative: static credentials.
# TURN_USERNAME=
# TURN_CREDENTIAL=

# all (default) | relay — "relay" forces TURN; useful to test your TURN server.
ICE_TRANSPORT_POLICY=all

# ---------------------------------------------------------------------------
# Client build (read by Vite at build time)
# ---------------------------------------------------------------------------
# Transfer limits (MB). Checked by the sender when files are chosen AND by the
# receiver before accepting, so a modified sender can't bypass them.
VITE_MAX_FILE_SIZE_MB=4096        # largest single file
VITE_MAX_TOTAL_SIZE_MB=10240      # largest total per transfer
VITE_MAX_FILES=500                # most files per transfer
# Browsers that can't stream to disk (e.g. Safari/iOS) hold received files in
# memory; transfers larger than this are refused on those devices.
VITE_MAX_IN_MEMORY_MB=1024

# Signaling server URL when it runs on a different origin than the frontend.
# Leave empty when the server also serves the client.
# VITE_SIGNALING_URL=https://signal.example.com
